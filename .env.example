# TruthCV Environment Variables Configuration

# 1. AI Engine (Vercel AI SDK - OpenAI or Google Gemini)
# Optional: Set at least one to enable live LLM generation; if omitted, TruthCV's built-in ethical generator runs deterministically!
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# 2. Supabase Configuration (Optional for guest mode; required for persistent cloud sync)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. Canonical Base URL for SEO Sitemaps and Schema
NEXT_PUBLIC_SITE_URL=https://truthcv.com
